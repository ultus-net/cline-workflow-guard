{
  "name": "cline-workflow-guard",
  "version": "1.2.0",
  "description": "Cline plugin enforcing workflow discipline through deterministic beforeTool hooks",
  "license": "MIT",
  "type": "module",
  "cline": {
    "plugins": [
      {
        "paths": [
          "./workflow-guard.ts"
        ],
        "capabilities": [
          "hooks"
        ]
      }
    ]
  },
  "peerDependencies": {
    "@cline/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@cline/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cline/sdk": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types test.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}